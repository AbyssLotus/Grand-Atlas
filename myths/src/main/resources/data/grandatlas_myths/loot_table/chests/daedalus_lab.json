                "minecraft:written_book_content": {
                  "title": "Notes of Daedalus",
                  "author": "Daedalus",
                  "pages": [
                    "\"The King asked for a prison no one could leave. I have built it. Corridors turn on corridors, and every turning looks like the last.\"",
                    "\"The walls will not yield to any pick. I made them so. Whoever wanders here must walk, and walking, learn the way, or never learn it.\"",
                    "\"The beast has the run of the halls. It keeps to my old workshops. I no longer go there.\"",
                    "\"Where the copper hatches glimmer in the ceiling, climb. They open on the world above. I placed them for the workmen. I have told no one else.\"",
                    "\"A thread, tied at the door, would lead anyone back. A simple thing. So simple the King never thought to forbid it.\""
                  ]
                }
              }
            }
          ]
        }
